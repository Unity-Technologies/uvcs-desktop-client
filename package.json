{
  "name": "uvcs-desktop",
  "productName": "Unity Version Control",
  "version": "0.1.0",
  "description": "A modern desktop client for Unity Version Control, powered by the cm CLI.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
